<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImageConverter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ImageConverter.App"
    xmlns:core="using:ImageConverter.Core"
    Title="Image Converter">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <DataTemplate x:Key="EnumItem">
                <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
            </DataTemplate>

            <DataTemplate x:Key="ListRow" x:DataType="core:ConvertItem">
                <Grid Height="52" ColumnSpacing="12" Background="Transparent" DoubleTapped="Item_DoubleTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image x:Name="Thumb" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis" Text="{x:Bind FileName}" ToolTipService.ToolTip="{x:Bind FullPath}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind local:Ui.SourceCaption(SourceFormat, SizeBytes)}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis" Text="{x:Bind TargetName, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind TargetPath, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                   Foreground="{x:Bind local:Ui.StatusBrush(Status), Mode=OneWay}"
                                   Text="{x:Bind local:Ui.TargetCaption(Status, OutputBytes, SizeBytes), Mode=OneWay}" />
                    </StackPanel>
                    <FontIcon Grid.Column="4" FontSize="14"
                              Glyph="{x:Bind local:Ui.StatusGlyph(Status), Mode=OneWay}"
                              Foreground="{x:Bind local:Ui.StatusBrush(Status), Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind local:Ui.StatusTip(Status, Message), Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <MenuFlyout x:Key="ItemMenu" Opening="ItemMenu_Opening">
                <MenuFlyoutItem x:Name="ConvertSelectedItem" Text="Convert selected" Click="ConvertSelected_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+Enter">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CreateGifItem" Text="Create GIF from selected" Click="CreateGif_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE786;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open" Click="OpenFile_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenConvertedItem" Text="Open converted file" Click="OpenConverted_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Show in File Explorer" Click="ShowInExplorer_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEC50;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Remove from list" Icon="Remove" Click="RemoveSelected_Click" KeyboardAcceleratorTextOverride="Del" />
            </MenuFlyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= title bar ======================= -->
        <Grid x:Name="AppTitleBar" Padding="16,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Image Converter" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.FolderTitle, Mode=OneWay}" />
        </Grid>

        <!-- ======================= command bar ======================= -->
        <CommandBar Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right" Margin="8,0" Background="Transparent"
                    IsDynamicOverflowEnabled="True">
            <!-- Each button binds its own IsEnabled: disabling the whole CommandBar while loading left
                 Remove/Clear looking disabled after it was re-enabled. -->
            <AppBarButton Label="Open folder" Click="OpenFolder_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Add images" Icon="Add" Click="AddImages_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            <AppBarToggleButton Label="Include subfolders" IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" Click="Subfolders_Click"
                                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarSeparator />
            <AppBarButton Label="Remove" Icon="Remove" Click="RemoveSelected_Click" IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                          ToolTipService.ToolTip="Remove selected images from the list (Del)" />
            <AppBarButton Label="Clear list" Icon="Clear" Click="ClearList_Click" IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}" />
            <AppBarSeparator />
            <AppBarButton Label="Create GIF" Click="CreateGif_Click" IsEnabled="{x:Bind ViewModel.CanCreateGif, Mode=OneWay}"
                          ToolTipService.ToolTip="Make an animated GIF from the selected images, in list order (select 2 or more)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE786;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar x:Name="Notice" Grid.Row="2" Margin="16,0,16,8" IsOpen="False" />

        <ContentDialog x:Name="GifDialog" Title="Create GIF" PrimaryButtonText="Create GIF" CloseButtonText="Cancel"
                       DefaultButton="Primary" PrimaryButtonClick="GifDialog_PrimaryButtonClick">
            <StackPanel Spacing="12" Width="380">
                <TextBlock x:Name="GifSummary" Style="{StaticResource Caption}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox Header="Frame delay (ms)" Minimum="20" Maximum="60000" SmallChange="50" SpinButtonPlacementMode="Compact"
                               Value="{x:Bind ViewModel.Gif.FrameDelayMs, Mode=TwoWay}" />
                    <NumberBox Grid.Column="1" Header="Loops (0 = forever)" Minimum="0" Maximum="1000" SpinButtonPlacementMode="Compact"
                               Value="{x:Bind ViewModel.Gif.Loops, Mode=TwoWay}" />
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="0,-6,0,0" Text="{x:Bind local:Ui.Fps(ViewModel.Gif.FrameDelayMs), Mode=OneWay}" />
                <CheckBox Content="Play forward, then backward" IsChecked="{x:Bind ViewModel.Gif.PingPong, Mode=TwoWay}" />
                <NumberBox Header="Longest side (px, 0 = first image's size)" Minimum="0" Maximum="8192" SmallChange="100"
                           SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.Gif.MaxSize, Mode=TwoWay}" />
                <StackPanel>
                    <CheckBox Content="Keep transparency" IsChecked="{x:Bind ViewModel.Gif.KeepTransparency, Mode=TwoWay}"
                              ToolTipService.ToolTip="Off: transparent areas and padding around smaller images are filled with the background colour (the 'Fill transparent areas' colour, currently shown in the swatch)." />
                    <CheckBox Content="Dither (smoother gradients, bigger file)" IsChecked="{x:Bind ViewModel.Gif.Dither, Mode=TwoWay}" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GifPathBox" Header="Save as" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse" Click="BrowseGif_Click" />
                </Grid>
                <TextBlock Style="{StaticResource Caption}"
                           Text="Frames follow the list order. Images of other sizes are fitted into the first image's frame and centred. GIF has 256 colours, so photos lose some quality." />
            </StackPanel>
        </ContentDialog>

        <!-- ======================= main area ======================= -->
        <Grid Grid.Row="3" Margin="16,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- options panel -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Spacing="12" Padding="16,12,16,16">

                        <!-- format -->
                        <TextBlock Text="Convert to" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Output format"
                                  ItemsSource="{x:Bind local:Choices.Formats}" DisplayMemberPath="Label"
                                  SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}" />

                        <StackPanel Spacing="4" Visibility="{x:Bind local:Ui.ShowIfQuality(ViewModel.Options.Info, ViewModel.Options.Lossless), Mode=OneWay}">
                            <Grid>
                                <TextBlock Text="Quality" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind local:Ui.Percent(ViewModel.Options.Quality), Mode=OneWay}" />
                            </Grid>
                            <Slider Minimum="1" Maximum="100" StepFrequency="1" AutomationProperties.Name="Quality"
                                    Value="{x:Bind ViewModel.Options.Quality, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Lower is smaller. 80–90 looks the same as the original for most photos." />
                        </StackPanel>

                        <ToggleSwitch Header="Compression" OffContent="Lossy (smaller)" OnContent="Lossless (exact pixels)"
                                      IsOn="{x:Bind ViewModel.Options.Lossless, Mode=TwoWay}"
                                      Visibility="{x:Bind local:Ui.ShowIfWebP(ViewModel.Options.Format), Mode=OneWay}" />

                        <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.ShowIfDds(ViewModel.Options.Format), Mode=OneWay}">
                            <ComboBox Header="Block compression" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind local:Choices.DdsCompressions}" ItemTemplate="{StaticResource EnumItem}"
                                      SelectedItem="{x:Bind ViewModel.Options.DdsCompression, Mode=TwoWay}" />
                            <CheckBox Content="Generate mipmaps" IsChecked="{x:Bind ViewModel.Options.DdsMipmaps, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Most game engines and GPUs want sizes that are multiples of 4, ideally powers of two (256, 512, 1024…). Mipmaps are only made for power-of-two sizes." />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Caption}" Visibility="{x:Bind local:Ui.ShowIfIco(ViewModel.Options.Format), Mode=OneWay}"
                                   Text="Creates one icon with 16, 32, 48 and 256 px sizes. Non-square images are padded with transparency." />

                        <StackPanel Spacing="4" Visibility="{x:Bind local:Ui.ShowIfNoAlpha(ViewModel.Options.Info), Mode=OneWay}">
                            <TextBlock Text="Fill transparent areas with" />
                            <DropDownButton AutomationProperties.Name="Background colour">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="18" Height="18" CornerRadius="3" BorderThickness="1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            Background="{x:Bind local:Ui.ColorBrush(ViewModel.Options.Background), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.Options.Background, Mode=OneWay}" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout Opening="BackgroundFlyout_Opening">
                                        <ColorPicker x:Name="BackgroundPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                     ColorChanged="BackgroundPicker_ColorChanged" />
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <!-- size -->
                        <TextBlock Text="Size" Style="{StaticResource SectionHeader}" />
                        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Resize"
                                  ItemsSource="{x:Bind local:Choices.ResizeModes}" ItemTemplate="{StaticResource EnumItem}"
                                  SelectedItem="{x:Bind ViewModel.Options.Resize, Mode=TwoWay}" />
                        <Grid ColumnSpacing="8" Visibility="{x:Bind local:Ui.ShowIfFit(ViewModel.Options.Resize), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Header="Max width" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact"
                                       ToolTipService.ToolTip="0 = no limit"
                                       Value="{x:Bind ViewModel.Options.MaxWidth, Mode=TwoWay}" />
                            <NumberBox Grid.Column="1" Header="Max height" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact"
                                       ToolTipService.ToolTip="0 = no limit"
                                       Value="{x:Bind ViewModel.Options.MaxHeight, Mode=TwoWay}" />
                        </Grid>
                        <NumberBox Header="Percent" Minimum="1" Maximum="1000" SpinButtonPlacementMode="Compact"
                                   Visibility="{x:Bind local:Ui.ShowIfPercent(ViewModel.Options.Resize), Mode=OneWay}"
                                   Value="{x:Bind ViewModel.Options.Percent, Mode=TwoWay}" />
                        <CheckBox Content="Allow enlarging small images" IsChecked="{x:Bind ViewModel.Options.AllowUpscale, Mode=TwoWay}"
                                  Visibility="{x:Bind local:Ui.ShowIfResizing(ViewModel.Options.Resize), Mode=OneWay}" />

                        <!-- metadata -->
                        <TextBlock Text="Metadata" Style="{StaticResource SectionHeader}" />
                        <ToggleSwitch OnContent="Keep camera info, date and GPS" OffContent="Remove (colour profile is kept)"
                                      AutomationProperties.Name="Keep metadata"
                                      IsOn="{x:Bind ViewModel.Options.KeepMetadata, Mode=TwoWay}" />

                        <!-- output -->
                        <TextBlock Text="Save to" Style="{StaticResource SectionHeader}" />
                        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Save location"
                                  ItemsSource="{x:Bind local:Choices.Locations}" ItemTemplate="{StaticResource EnumItem}"
                                  SelectedItem="{x:Bind ViewModel.Options.Location, Mode=TwoWay}" />
                        <TextBox Header="Subfolder name" Visibility="{x:Bind local:Ui.ShowIfSubfolder(ViewModel.Options.Location), Mode=OneWay}"
                                 Text="{x:Bind ViewModel.Options.SubfolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.ShowIfFolder(ViewModel.Options.Location), Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Folder" PlaceholderText="Choose a folder"
                                         Text="{x:Bind ViewModel.Options.OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse" Click="BrowseOutput_Click" />
                            </Grid>
                            <CheckBox Content="Keep subfolders" IsChecked="{x:Bind ViewModel.Options.KeepFolderStructure, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Recreate the folders below the one you opened" />
                        </StackPanel>
                        <TextBox Header="Add to file name" PlaceholderText="e.g. _small"
                                 Text="{x:Bind ViewModel.Options.Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Header="If a file with that name exists" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind local:Choices.Conflicts}" ItemTemplate="{StaticResource EnumItem}"
                                  SelectedItem="{x:Bind ViewModel.Options.Conflict, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Originals are never changed or deleted." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- images -->
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="28,10,28,6" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Original" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Converted" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <ListView x:Name="ItemsList" Grid.Row="1" SelectionMode="Extended" Padding="4,0,4,8"
                          ItemsSource="{x:Bind ViewModel.Items}"
                          ItemTemplate="{StaticResource ListRow}"
                          ContextFlyout="{StaticResource ItemMenu}"
                          SelectionChanged="Items_SelectionChanged"
                          ContainerContentChanging="Items_ContainerContentChanging"
                          KeyDown="Items_KeyDown" />

                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind local:Ui.Hide(ViewModel.HasItems), Mode=OneWay}">
                    <FontIcon Glyph="&#xEB9F;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Drop images or a folder here" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="JPG, PNG, WebP, HEIC, AVIF, TIFF, DDS, TGA, PSD, RAW and more" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}" Content="Open folder" Click="OpenFolder_Click" />
                        <Button Content="Add images" Click="AddImages_Click" />
                    </StackPanel>
                </StackPanel>

                <ProgressRing Grid.RowSpan="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- ======================= footer ======================= -->
        <Grid Grid.Row="4" Padding="16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="RangeBox" PlaceholderText="Select: 5915-5920, #1-#10, IMG_*" QueryIcon="Find"
                            QuerySubmitted="RangeBox_QuerySubmitted" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            ToolTipService.ToolTip="Numbers match any number in the file name. #3-#8 are list positions. Wildcards match names (*.dds). Separate parts with commas. Press Enter to select." />
            <DropDownButton Grid.Column="1" Content="Select" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <MenuFlyoutItem Text="Select matching" Click="SelectMatching_Click" />
                        <MenuFlyoutItem Text="Add matching to selection" Click="AddMatching_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Select all" Click="SelectAll_Click" KeyboardAcceleratorTextOverride="Ctrl+A" />
                        <MenuFlyoutItem Text="Select none" Click="SelectNone_Click" />
                        <MenuFlyoutItem Text="Invert selection" Click="InvertSelection_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Select images that failed" Click="SelectFailed_Click" />
                        <MenuFlyoutItem Text="Select images not converted yet" Click="SelectNotConverted_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="4,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" />
            <Grid Grid.Column="3" ColumnSpacing="12" Margin="8,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <ProgressBar Grid.Column="1" MaxWidth="220" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                             Maximum="{x:Bind ViewModel.RunCount, Mode=OneWay}"
                             Value="{x:Bind ViewModel.FinishedCount, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
            </Grid>
            <Button Grid.Column="4" Click="OpenOutputFolder_Click" ToolTipService.ToolTip="Open output folder"
                    AutomationProperties.Name="Open output folder"
                    Visibility="{x:Bind ViewModel.HasOutputFolder, Mode=OneWay}">
                <FontIcon Glyph="&#xE838;" FontSize="14" />
            </Button>
            <Button Grid.Column="5" MinWidth="100" Content="Cancel" Click="Cancel_Click"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
            <!-- The button for what the user most likely wants is the accent one: the selection, when there is one. -->
            <Button Grid.Column="6" MinWidth="120" AutomationProperties.Name="Convert selected"
                    Style="{x:Bind local:Ui.AccentIf(ViewModel.HasSelection), Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanConvertSelected, Mode=OneWay}" Click="ConvertSelected_Click"
                    ToolTipService.ToolTip="Convert only the selected images (Ctrl+Shift+Enter)">
                <TextBlock Text="{x:Bind ViewModel.ConvertSelectedText, Mode=OneWay}" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="Enter" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button Grid.Column="7" MinWidth="120" AutomationProperties.Name="Convert all"
                    Style="{x:Bind local:Ui.AccentUnless(ViewModel.HasSelection), Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanConvert, Mode=OneWay}" Click="Convert_Click"
                    ToolTipService.ToolTip="Convert every image in the list (Ctrl+Enter)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                    <TextBlock Text="Convert all" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="Enter" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Window>
